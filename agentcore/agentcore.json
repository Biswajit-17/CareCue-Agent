{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "CareCue",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "CareCue"
  },
  "runtimes": [
    {
      "name": "carecue_agent",
      "build": "CodeZip",
      "entrypoint": "app/carecue_agent/main.py",
      "codeLocation": ".",
      "runtimeVersion": "PYTHON_3_13",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "envVars": [
        { "name": "GMAIL_SMTP_USER", "value": "YOUR_GMAIL@gmail.com" },
        { "name": "GMAIL_SMTP_APP_PASSWORD", "value": "YOUR_APP_PASSWORD" }
      ]
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "capacityProviders": [],
  "payments": []
}